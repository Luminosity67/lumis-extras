{
  "manifest_version": 3,
  "name": "Lumi's Extras",
  "version": "1.0.26",
  "description": "Quality-of-life and cosmetic extras for mope.io: cooldown timers, HP numbers, camera zoom, party map and chat, name colours.",
  "homepage_url": "https://github.com/Luminosity67/lumis-extras",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://mope.io/*", "*://*.mope.io/*"],
      "js": ["lumis-extras.user.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
